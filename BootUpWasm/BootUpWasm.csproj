<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<AssemblyName>BootUpWasm</AssemblyName>
		<RootNamespace>BootUpWasm</RootNamespace>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- emits the manifest ManifestEmbeddedFileProvider reads -->
		<GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
	</PropertyGroup>

	<PropertyGroup>
		<OurDrawingVersion>30.0.0.0</OurDrawingVersion>
	</PropertyGroup>

	<!-- ══════════ BROWSER-WASM GATE ══════════
       Set explicitly by the consumer (AdditionalProperties / -p: / Directory.Build.props),
       otherwise auto-detect a browser-wasm build. -->
	<PropertyGroup>
		<XplatBrowserWasm Condition="'$(XplatBrowserWasm)' == '' and
                                 ('$(RuntimeIdentifier)' == 'browser-wasm' or
                                  $(RuntimeIdentifier.StartsWith('browser-')) or
                                  '$(TargetPlatformIdentifier)' == 'browser')">true</XplatBrowserWasm>
		<XplatBrowserWasm Condition="'$(XplatBrowserWasm)' == ''">false</XplatBrowserWasm>
	</PropertyGroup>



	<PropertyGroup Condition="'$(XplatBrowserWasm)' == 'true'">
		<!-- so shared sources can #if out anything Kestrel/sockets/threading -->
		<DefineConstants>$(DefineConstants);BROWSER_WASM</DefineConstants>
		<!-- never produce the desktop nupkg from a wasm build -->
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
	</PropertyGroup>

	<Target Name="EvictPackSystemDrawing" AfterTargets="ResolveAssemblyReferences"
		BeforeTargets="WasmBuildProduce;_BrowserWasmWriteRspForLinking">
		<ItemGroup>
			<WasmAssembliesToBundle Remove="@(WasmAssembliesToBundle)"
			  Condition="'%(FileName)' == 'System.Drawing' and $([System.String]::Copy('%(FullPath)').Contains('dotnet\packs'))" />
			<_WasmAssembliesToBundle Remove="@(_WasmAssembliesToBundle)"
			  Condition="'%(FileName)' == 'System.Drawing' and $([System.String]::Copy('%(FullPath)').Contains('dotnet\packs'))" />
			<ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)"
			  Condition="'%(FileName)' == 'System.Drawing' and $([System.String]::Copy('%(FullPath)').Contains('dotnet\packs'))" />
		</ItemGroup>
	</Target>

	<Target Name="AuditAndDropSystemDrawing" AfterTargets="ResolveAssemblyReferences">

		<!-- audit: paste these lines if anything is still wrong -->
		<Message Importance="high"
				 Text="[sd] REF  %(ReferencePath.FileName) | Fusion='%(ReferencePath.FusionName)' | Src=%(ReferencePath.ReferenceSourceTarget) | From=%(ReferencePath.ResolvedFrom) | %(ReferencePath.FullPath)"
				 Condition="'%(ReferencePath.FileName)' == 'System.Drawing'
                        or '%(ReferencePath.FileName)' == 'System.Drawing.Common'
                        or '%(ReferencePath.FileName)' == 'System.Drawing.Primitives'" />
		<Message Importance="high"
				 Text="[sd] COPY %(ReferenceCopyLocalPaths.FileName) | Fusion='%(ReferenceCopyLocalPaths.FusionName)' | Src=%(ReferenceCopyLocalPaths.ReferenceSourceTarget) | %(ReferenceCopyLocalPaths.FullPath)"
				 Condition="'%(ReferenceCopyLocalPaths.FileName)' == 'System.Drawing'
                        or '%(ReferenceCopyLocalPaths.FileName)' == 'System.Drawing.Common'
                        or '%(ReferenceCopyLocalPaths.FileName)' == 'System.Drawing.Primitives'" />

		<ItemGroup>
			<!-- ══ reference set ══ -->
			<!-- never ours -->
			<_ForeignRef Include="@(ReferencePath)"
						 Condition="'%(ReferencePath.FileName)' == 'System.Drawing.Common'
                              or '%(ReferencePath.FileName)' == 'System.Drawing.Primitives'" />
			<!-- System.Drawing: drop the signed / wrong-version copies (ours = unsigned 30.0.0.0) -->
			<_ForeignRef Include="@(ReferencePath)"
						 Condition="'%(ReferencePath.FileName)' == 'System.Drawing'
                              and ($([System.String]::Copy('%(ReferencePath.FusionName)').Contains('PublicKeyToken=b03f5f7f11d50a3a'))
                                or $([System.String]::Copy('%(ReferencePath.FusionName)').Contains('PublicKeyToken=cc7b13ffcd2ddd51'))
                                or $([System.String]::Copy('%(ReferencePath.FusionName)').Contains('Version=4.0.0.0'))
                                or (!$([System.String]::Copy('%(ReferencePath.FusionName)').Equals(''))
                                    and !$([System.String]::Copy('%(ReferencePath.FusionName)').Contains('Version=$(OurDrawingVersion)'))))" />

			<!-- ══ copy-local ══ -->
			<!-- never ours -->
			<_ForeignCopy Include="@(ReferenceCopyLocalPaths)"
						  Condition="'%(ReferenceCopyLocalPaths.FileName)' == 'System.Drawing.Common'
                               or '%(ReferenceCopyLocalPaths.FileName)' == 'System.Drawing.Primitives'" />
			<!-- the copy of exactly the files we just dropped from the reference set -->
			<_ForeignCopy Include="@(ReferenceCopyLocalPaths)"
						  Condition="'%(ReferenceCopyLocalPaths.FileName)' == 'System.Drawing'
                               and '@(_ForeignRef)' != ''
                               and '@(_ForeignRef)' == '%(ReferenceCopyLocalPaths.FullPath)'" />

			<!-- removes: strictly per list -->
			<ReferencePath Remove="@(_ForeignRef)" />
			<ReferenceCopyLocalPaths Remove="@(_ForeignCopy)" />
			<_ResolvedCopyLocalBuildAssets Remove="@(_ForeignCopy)" />
		</ItemGroup>

		<Message Importance="high" Text="[sd] DROPPED-REF %(_ForeignRef.Identity)" />
		<Message Importance="high" Text="[sd] DROPPED-COPY %(_ForeignCopy.Identity)" />
	</Target>

	<ItemGroup>
		<StaticWebAssetFingerprintPattern Include="JS" Pattern="*.js" Expression="#[.{fingerprint}]!" />
	</ItemGroup>

	<ItemGroup>
		<!-- nothing is embedded unless this is here; viewer.html is picked up by *.html -->
		<EmbeddedResource Include="*.cs;*.html;*.csproj;Properties\**" />
		<EmbeddedResource Include="assets\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="11.0.0-rc.2.*" />
		<!-- only if your System.Drawing project does not bring Skia's wasm assets transitively -->
		<!-- <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" Version="…" /> -->
	</ItemGroup>

	<!-- identical to BootUpSD: keep the framework's System.Drawing.* out of the way -->
	<Target Name="AliasFrameworkDrawingReferences" AfterTargets="ResolveAssemblyReferences" BeforeTargets="CoreCompile">
		<ItemGroup>
			<ReferencePath Condition="'%(FileName)' == 'System.Drawing.Primitives'">
				<Aliases>sysdrawing</Aliases>
			</ReferencePath>
			<ReferencePath Condition="'%(FileName)' == 'System.Drawing.Common'">
				<Aliases>sysdrawingcommon</Aliases>
			</ReferencePath>
		</ItemGroup>
	</Target>

	<ItemGroup>
		<ProjectReference Include="..\System.Drawing.Design\System.Drawing.Design.csproj" />
		<ProjectReference Include="..\..\..\..\invnew\System.Drawing\System.Drawing.csproj" />
		<ProjectReference Include="..\System.Windows.Forms\System.Windows.Forms.csproj" />
	</ItemGroup>

	<PropertyGroup>
		<!--<EmccExtraLDFlags>$(EmccExtraLDFlags) -sSUPPORT_LONGJMP=emscripten</EmccExtraLDFlags>-->
		<EmccFlags>-sSUPPORT_LONGJMP=wasm</EmccFlags>
	</PropertyGroup>

	<ItemGroup>
		
		<!--<NativeFileReference Include="wasm_sjlj_shim.cpp" />-->
	</ItemGroup>

</Project>