<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>


	<!-- ADD THIS SINGLE TARGET -->
	<Target Name="AliasFrameworkDrawingReferences" AfterTargets="ResolveAssemblyReferences" BeforeTargets="CoreCompile">
		<ItemGroup>
			<!-- Alias the framework's System.Drawing.Primitives so it doesn't collide with your custom System.Drawing.dll -->
			<ReferencePath Condition="'%(FileName)' == 'System.Drawing.Primitives'">
				<Aliases>sysdrawing</Aliases>
			</ReferencePath>
			<!-- Also alias System.Drawing.Common just in case ConfigurationManager pulls it in -->
			<ReferencePath Condition="'%(FileName)' == 'System.Drawing.Common'">
				<Aliases>sysdrawingcommon</Aliases>
			</ReferencePath>

		</ItemGroup>
	</Target>

	<ItemGroup>
		<ProjectReference Include="..\System.Drawing.Design\System.Drawing.Design.csproj" />
		<ProjectReference Include="..\..\..\..\invnew\System.Drawing\System.Drawing.csproj" />
		<PackageReference Include="SkiaSharp" Version="4.148.0" />
		<PackageReference Include="SkiaSharp.Svg" Version="1.60.0" />
		<!--<PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.148.0" />-->
		<!--We don't target NoDeps now-->
		<PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.148.0" />
		<PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.148.0" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\System.Windows.Forms\System.Windows.Forms.csproj" />
	</ItemGroup>

</Project>
